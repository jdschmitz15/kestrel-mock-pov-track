#!/bin/bash
# --- check helpers ---
fail() { if command -v fail-message >/dev/null 2>&1; then fail-message "$1"; fi; echo "FAIL: $1"; exit 1; }
need_pce() { [[ -s /root/.pce/env ]] || fail "No PCE details yet. Run pov-connect in the Client tab."; }
# --- end check helpers ---
grep -q 'PASS' /root/preflight.txt 2>/dev/null || fail "Run preflight <your-pce-hostname> in the Client tab. Every line must end in PASS."
f=/root/kestrel/preflight-aws.txt
[[ -s $f ]] || fail "Run kp preflight in the Client tab to check the four AWS servers."
n=$(grep -c '| PASS' "$f" || true)
[[ $n -ge 4 ]] || fail "Only $n of 4 AWS servers passed. Look at $f, fix the problem, and run kp preflight again."
