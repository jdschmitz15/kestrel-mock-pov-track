#!/bin/bash
# --- check helpers ---
fail() { if command -v fail-message >/dev/null 2>&1; then fail-message "$1"; fi; echo "FAIL: $1"; exit 1; }
need_pce() { [[ -s /root/.pce/env ]] || fail "No PCE details yet. Run pov-connect in the Client tab."; }
# --- end check helpers ---
need_pce
pce ruleset "Claims | POV" --active >/dev/null 2>&1 || fail "No provisioned ruleset named 'Claims | POV'. Create it, then Provision."
for h in kp-web01 kp-sql01; do
  [[ $(pce workloads --host "$h" | jq -r '.[0].enforcement_mode') == full ]] || fail "$h is not in Full enforcement yet."
done
code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 http://kp-web01/ || true)
[[ $code == 200 ]] || fail "The Claims app returned $code instead of 200. Check rules 1 and 2 (Users to Web on 80, Web to DB on 1433)."
