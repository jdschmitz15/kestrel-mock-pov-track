#!/bin/bash
# Heuristic: CloudSecure onboarding creates an IAM role and a CloudFormation stack with "illumio" in
# the name. /opt/kestrel/.test-skip-cloudsecure is written only by the solve script for automated tests.
#@include src/snippets/check-lib.sh
[[ -f /opt/kestrel/.test-skip-cloudsecure ]] && exit 0
AWS_REGION=$(cat /opt/kestrel/aws-region); export AWS_REGION
roles=$(aws iam list-roles --query 'Roles[].RoleName' --output text 2>/dev/null | tr '\t' '\n' | grep -ci illumio || true)
stacks=$(aws cloudformation list-stacks --stack-status-filter CREATE_COMPLETE UPDATE_COMPLETE \
         --query 'StackSummaries[].StackName' --output text 2>/dev/null | tr '\t' '\n' | grep -ci illumio || true)
[[ $roles -ge 1 || $stacks -ge 1 ]] || fail "No Illumio role or CloudFormation stack in the AWS account yet. Finish the CloudFormation step from CloudSecure onboarding."
