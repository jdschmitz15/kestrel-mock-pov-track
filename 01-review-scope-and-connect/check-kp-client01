#!/bin/bash
# --- check helpers ---
fail() { if command -v fail-message >/dev/null 2>&1; then fail-message "$1"; fi; echo "FAIL: $1"; exit 1; }
need_pce() { [[ -s /root/.pce/env ]] || fail "No PCE details yet. Run pov-connect in the Client tab."; }
# --- end check helpers ---
need_pce
pce raw GET "/labels?max_results=1" >/dev/null 2>&1 || fail "The PCE API did not accept your key. Run pov-connect again and check the hostname, org ID, key and secret."
pce pairing-profile >/dev/null 2>&1 || fail "Pairing profile Kestrel-POV not found. Run pov-connect again."
